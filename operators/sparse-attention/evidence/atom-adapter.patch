diff --git a/atom/model_ops/deepseek_v41/hip_sparse_attention.py b/atom/model_ops/deepseek_v41/hip_sparse_attention.py
new file mode 100644
index 0000000..2a85cb6
--- /dev/null
+++ b/atom/model_ops/deepseek_v41/hip_sparse_attention.py
@@ -0,0 +1,177 @@
+# SPDX-License-Identifier: MIT
+"""Opt-in launcher for AITER's gfx942 BF16 two-source sparse attention."""
+
+import ctypes
+import logging
+from functools import cache
+
+import torch
+from aiter.jit.utils.chip_info import get_gfx_runtime
+
+from atom.utils import envs
+
+logger = logging.getLogger("atom")
+
+
+def supports_hip_sparse_attention(q: torch.Tensor) -> bool:
+    return bool(
+        envs.ATOM_DSV41_HIP_SPARSE_ATTN_LIB
+        and not torch.compiler.is_compiling()
+        and q.is_cuda
+        and q.dtype == torch.bfloat16
+        and q.shape[-1] == 512
+        and get_gfx_runtime() == "gfx942"
+    )
+
+
+@cache
+def _load_library(path: str):
+    lib = ctypes.CDLL(path)
+    lib.sparse_attn_v4_gfx942_splits.argtypes = [ctypes.c_int] * 4
+    lib.sparse_attn_v4_gfx942_splits.restype = ctypes.c_int
+    lib.sparse_attn_v4_gfx942_workspace_bytes.argtypes = [ctypes.c_int] * 3
+    lib.sparse_attn_v4_gfx942_workspace_bytes.restype = ctypes.c_longlong
+    lib.sparse_attn_v4_gfx942_launch.argtypes = (
+        [ctypes.c_void_p] * 9
+        + [ctypes.c_longlong] * 6
+        + [ctypes.c_int] * 3
+        + [ctypes.c_float]
+        + [ctypes.c_void_p] * 4
+        + [ctypes.c_longlong, ctypes.c_int, ctypes.c_void_p]
+    )
+    lib.sparse_attn_v4_gfx942_launch.restype = ctypes.c_int
+    logger.info("DeepSeek-V4.1 HIP sparse attention library loaded from %s", path)
+    return lib
+
+
+@cache
+def _log_dispatch(decode: bool, fused_rope: bool):
+    logger.info(
+        "DeepSeek-V4.1 HIP sparse attention dispatched in %s, fused inverse RoPE=%s",
+        "Decode" if decode else "Prefill",
+        fused_rope,
+    )
+
+
+def hip_sparse_attention(
+    q: torch.Tensor,
+    prefix_kv: torch.Tensor,
+    prefix_indices: torch.Tensor,
+    prefix_indptr: torch.Tensor,
+    extend_kv: torch.Tensor,
+    extend_indices: torch.Tensor,
+    extend_indptr: torch.Tensor,
+    sink: torch.Tensor,
+    scale: float,
+    *,
+    decode: bool,
+    rope=None,
+    positions: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Launch on the current stream with graph-local split workspace."""
+    tokens, heads, dim = q.shape
+    if not tokens:
+        return q
+
+    # The HIP ABI vector-loads Q and KV and uses unit-stride CSR indices.
+    if not (
+        q.is_contiguous()
+        and q.data_ptr() % 8 == 0
+        and all(
+            kv.ndim == 2
+            and kv.shape[-1] == dim
+            and kv.device == q.device
+            and kv.dtype == q.dtype
+            and kv.stride(-1) == 1
+            and kv.stride(0) % 8 == 0
+            and kv.data_ptr() % 16 == 0
+            for kv in (prefix_kv, extend_kv)
+        )
+        and all(
+            csr.ndim == 1
+            and csr.device == q.device
+            and csr.dtype == torch.int32
+            and csr.is_contiguous()
+            for csr in (prefix_indices, prefix_indptr, extend_indices, extend_indptr)
+        )
+        and prefix_indptr.numel() == extend_indptr.numel() == tokens + 1
+        and sink.shape == (heads,)
+        and sink.device == q.device
+        and sink.dtype == torch.float32
+        and sink.is_contiguous()
+    ):
+        raise RuntimeError("Unsupported DeepSeek-V4.1 HIP sparse attention layout")
+
+    cos_ptr = sin_ptr = pos_ptr = rope_stride = rope_dim = 0
+    if rope is not None:
+        cos, sin = rope.cos_cache, rope.sin_cache
+        if not (
+            positions is not None
+            and positions.shape == (tokens,)
+            and positions.dtype == torch.int64
+            and positions.device == q.device
+            and positions.is_contiguous()
+            and cos.shape == sin.shape
+            and cos.ndim == 2
+            and cos.shape[1] == 32
+            and cos.dtype == sin.dtype == torch.bfloat16
+            and cos.device == sin.device == q.device
+            and cos.is_contiguous()
+            and sin.is_contiguous()
+        ):
+            raise RuntimeError("Unsupported DeepSeek-V4.1 HIP inverse RoPE layout")
+        cos_ptr, sin_ptr, pos_ptr = cos.data_ptr(), sin.data_ptr(), positions.data_ptr()
+        rope_stride, rope_dim = cos.stride(0), 64
+
+    with torch.cuda.device(q.device):
+        lib = _load_library(envs.ATOM_DSV41_HIP_SPARSE_ATTN_LIB)
+        num_cus = torch.cuda.get_device_properties(q.device).multi_processor_count
+        # Index capacity chooses a split count without a device-to-host read.
+        # The kernel uses each row's true CSR endpoints to read the slots.
+        avg_keys = (prefix_indices.numel() + extend_indices.numel()) // tokens
+        splits = lib.sparse_attn_v4_gfx942_splits(tokens, heads, avg_keys, num_cus)
+        workspace = None
+        if splits > 1:
+            # Stage 1 initializes every partial before combine reads it.
+            workspace = torch.empty(
+                lib.sparse_attn_v4_gfx942_workspace_bytes(tokens, heads, splits),
+                dtype=torch.uint8,
+                device=q.device,
+            )
+        # The split stage reads Q and its combine writes the result in a
+        # later kernel. The unsplit kernel requires non-aliasing Q and O.
+        out = q if splits > 1 else torch.empty_like(q)
+        status = lib.sparse_attn_v4_gfx942_launch(
+            q.data_ptr(),
+            prefix_kv.data_ptr(),
+            prefix_indices.data_ptr(),
+            prefix_indptr.data_ptr(),
+            extend_kv.data_ptr(),
+            extend_indices.data_ptr(),
+            extend_indptr.data_ptr(),
+            sink.data_ptr(),
+            out.data_ptr(),
+            q.stride(0),
+            q.stride(1),
+            prefix_kv.stride(0),
+            extend_kv.stride(0),
+            out.stride(0),
+            out.stride(1),
+            tokens,
+            heads,
+            splits,
+            scale,
+            None if workspace is None else workspace.data_ptr(),
+            cos_ptr,
+            sin_ptr,
+            pos_ptr,
+            rope_stride,
+            rope_dim,
+            torch.cuda.current_stream(q.device).cuda_stream,
+        )
+        if status:
+            raise RuntimeError(
+                f"DeepSeek-V4.1 HIP sparse attention launch failed ({status})"
+            )
+    _log_dispatch(decode, rope is not None)
+    return out
