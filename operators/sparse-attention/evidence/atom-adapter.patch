 from atom.model_ops.deepseek_v41.paged_scoring import (
     quantize_query_fp4,
     score_topk_paged,
@@ -432,7 +436,7 @@ class Attention(nn.Module):
             "mxfp8 epilogue" if self._fuse_woa_quant else "shape unsupported",
         )
 
-    def _project_out(self, output, rope, positions):
+    def _project_out(self, output, rope, positions, *, inverse_rope_fused=False):
         """Inverse RoPE fused into the MXFP8 group quant, then the grouped FP8
         `wo_a` GEMM and `wo_b`. `positions` are the rows' positions, in the
         order of `output`'s leading dims.
@@ -443,16 +447,17 @@ class Attention(nn.Module):
             x = output.reshape(rows, self.heads, self.head_dim)
             if not x.is_contiguous():
                 x = x.contiguous()
-            pos = positions.flatten()
-            if pos.stride(0) != 1:
-                pos = pos.contiguous()
-            inverse_rope_inplace(
-                x,
-                rope.cos_cache[:, None, None, :],
-                rope.sin_cache[:, None, None, :],
-                pos,
-                rope.rope_dim,
-            )
+            if not inverse_rope_fused:
+                pos = positions.flatten()
+                if pos.stride(0) != 1:
+                    pos = pos.contiguous()
+                inverse_rope_inplace(
+                    x,
+                    rope.cos_cache[:, None, None, :],
+                    rope.sin_cache[:, None, None, :],
+                    pos,
+                    rope.rope_dim,
+                )
             # Written through a [G, M, N] view: wo_b needs no transpose copy.
             w = self.wo_a.weight.view(self.groups, self.o_rank, -1)
             x = x.view(rows, self.groups, -1)
@@ -566,11 +571,27 @@ class Attention(nn.Module):
         # joined -- with or without a forked scorer (`ATOM_DSV41_SIDE_STREAMS`
         # 1 forks the compressor alone).
         join_stream(self.index_stream, self.compress_stream)
-        output = self._attend(query, cache, step, queries, prepared)
+        use_hip = (
+            not cache.packed
+            and not cache.kv_fp8
+            and supports_hip_sparse_attention(query)
+        )
+        # Quantized wo_a already fuses inverse RoPE into MXFP8 group quant.
+        hip_rope = (
+            rope
+            if use_hip
+            and self.wo_a.weight.dtype == torch.bfloat16
+            and rope.rope_dim == 64
+            else None
+        )
+        output = self._attend(
+            query, cache, step, queries, prepared, use_hip=use_hip, hip_rope=hip_rope
+        )
         return self._project_out(
             output.view_as(query),
             rope,
             cache.rope_positions(step) if queries is None else queries.positions,
+            inverse_rope_fused=hip_rope is not None,
         )
 
     def _prepare_attention(self, query, kv_normed, cache, step, rope, queries):
@@ -617,7 +638,9 @@ class Attention(nn.Module):
         return a8w4, query_fp8, kv, window_kv
 
     @eager_region(live=_live_rows)
-    def _attend(self, query, cache, step, queries, prepared=None):
+    def _attend(
+        self, query, cache, step, queries, prepared=None, *, use_hip=False, hip_rope=None
+    ):
         if not step.requests:  # a dummy prefill on a token graph
             return query
         if prepared is None:
@@ -639,6 +662,14 @@ class Attention(nn.Module):
             attending = tuple(part.flatten(0, 1) for part in query_fp8)
             if a8w4:
                 kwargs["pool_scale_dtype"] = torch.float8_e4m3fn
+        elif use_hip:
+            attend = hip_sparse_attention
+            attending = flat_query
+            kwargs = {"decode": step.decode, "rope": hip_rope}
+            if hip_rope is not None:
+                kwargs["positions"] = (
+                    cache.rope_positions(step) if queries is None else queries.positions
+                ).flatten()
         else:
             attend = packed_prefill if cache.packed else sparse_attn_v4_paged_2src
             attending = flat_query
