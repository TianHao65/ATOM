@@ -126,0 +127,47 @@ class A8W4Weights:
+@dataclass(frozen=True)
+class A8W4SharedWeights:
+    """One FP8 PTPC expert in the decode kernels' private weight layout."""
+
+    w1: torch.Tensor
+    w1_scale: torch.Tensor
+    w2: torch.Tensor
+    w2_scale: torch.Tensor
+    hidden: int
+    inter: int
+
+
+def prepare_a8w4_shared_weights(w1, w1_scale, w2, w2_scale):
+    """Preshuffle one shared expert's unshuffled FNUZ weights without requantizing.
+
+    Gate/up is ``[2I, H]`` with the gate rows first and down is ``[H, I]``.
+    Both use FP32 per-output-channel scales and have no intermediate padding.
+    """
+    hidden, inter = w2.shape
+    if (
+        w1.shape != (2 * inter, hidden)
+        or hidden % 512
+        or inter % 64
+        or any(w.dtype != torch.float8_e4m3fnuz for w in (w1, w2))
+    ):
+        raise ValueError("Expected unshuffled FNUZ shared weights [2I,H] and [H,I]")
+
+    def pack(weight, scale):
+        rows, cols = weight.shape
+        if (
+            scale.dtype != torch.float32
+            or scale.shape not in ((rows,), (rows, 1))
+            or weight.device != w2.device
+            or scale.device != w2.device
+        ):
+            raise ValueError("Expected one FP32 scale per FP8 output channel")
+        # The FP4 layout holds eight packed bytes at each of these lane offsets.
+        # This format holds the same sixteen logical weights as FP8 bytes.
+        values = weight.contiguous().view(torch.uint8)
+        values = values.view(rows // 16, 16, cols // 64, 4, 16)
+        return values.permute(0, 2, 3, 1, 4).contiguous(), scale.reshape(rows).contiguous()
+
+    q1, s1 = pack(w1, w1_scale)
+    q2, s2 = pack(w2, w2_scale)
+    return A8W4SharedWeights(q1, s1, q2, s2, hidden, inter)
+
+
