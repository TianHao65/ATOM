@@ -37,0 +38,9 @@ LDS_BYTES = 64 * 1024  # LDS of one workgroup on gfx942
+def clamp_gateup(gate, up, limit):
+    """Clamp the gate from above and the up projection on both sides."""
+    if limit > 0:
+        bound = fx.Float32(limit)
+        gate = fx.minnumf(gate, bound)
+        up = fx.minnumf(fx.maxnumf(up, -bound), bound)
+    return gate, up
+
+
